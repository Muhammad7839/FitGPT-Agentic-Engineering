# Optional for local development — if left unset/blank, the backend automatically
# falls back to a local SQLite database (backend/fitgpt.db). Required and must be
# a PostgreSQL connection string when ENVIRONMENT=production.
DATABASE_URL=
SECRET_KEY=your_jwt_secret_here
GROQ_API_KEY=your_groq_api_key_here
GMAIL_ADDRESS=your_gmail_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here
FRONTEND_URL=http://localhost:3000
OPENWEATHER_API_KEY=your_openweather_key_here
